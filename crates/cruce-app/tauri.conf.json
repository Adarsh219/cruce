{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cruce",
  "version": "0.3.0",
  "identifier": "com.cruce.launcher",
  "build": {
    "beforeDevCommand": "cd ../../ui && bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../../ui && bun run build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cruce",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
